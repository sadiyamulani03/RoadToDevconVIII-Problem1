# Deployment signer for Base Sepolia (chain id 84532).
# Use a throwaway account funded ONLY with Base Sepolia test ETH.
# NEVER commit a real .env file — .env is gitignored.
PRIVATE_KEY=

# RPC endpoint used by the deployment script.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Chain id the deployment script must see before broadcasting.
# Leave unset for the standard Base Sepolia deployment (84532).
TARGET_CHAIN_ID=84532
