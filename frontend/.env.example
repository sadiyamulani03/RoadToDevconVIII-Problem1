# Frontend environment (optional — most builds need none of these).

# Contract address override. When unset, the committed value in
# src/config/deployment.generated.ts (written by scripts/sync-deployment.mjs)
# is used. When neither exists the UI shows an explicit "not configured" state.
VITE_CONTRACT_ADDRESS=

# First block containing deployment events. Enables the recent-games index
# without scanning a wide block range. Ignored when unset.
VITE_DEPLOY_BLOCK=

# ERC-7706/7677 paymaster service URL for gas-sponsored Base Account
# transactions on Base Sepolia (e.g. your Coinbase Developer Platform
# paymaster endpoint). When empty, wallets pay gas with testnet ETH instead.
VITE_PAYMASTER_URL=

# Development only: attach a local anvil chain for contract-level testing.
# Never set this for production builds — the app targets Base Sepolia only.
VITE_LOCAL_RPC=
VITE_LOCAL_CHAIN_ID=
